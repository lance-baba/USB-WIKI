# 统一换行符策略 —— 避免跨平台克隆后脚本无法执行
* text=auto eol=lf

# POSIX 脚本必须保持 LF：CRLF 会导致 `bad interpreter: /bin/bash^M`
*.sh            text eol=lf
*.command       text eol=lf
*.bash          text eol=lf

# Windows 脚本保持 CRLF
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# 常见文本类型显式声明为 LF
*.py            text eol=lf
*.js            text eol=lf
*.html          text eol=lf
*.css           text eol=lf
*.json          text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.toml          text eol=lf
*.md            text eol=lf
*.txt           text eol=lf

# 二进制文件不得做任何转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.whl   binary
*.dll   binary
*.pyd   binary
*.exe   binary
*.db    binary
*.woff  binary
*.woff2 binary

# 统一换行符策略 —— 避免跨平台克隆后脚本无法执行
* text=auto eol=lf

# POSIX 脚本必须保持 LF：CRLF 会导致 `bad interpreter: /bin/bash^M`
*.sh            text eol=lf
*.command       text eol=lf
*.bash          text eol=lf

# Windows 脚本保持 CRLF
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# 常见文本类型显式声明为 LF
*.py            text eol=lf
*.js            text eol=lf
*.html          text eol=lf
*.css           text eol=lf
*.json          text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.toml          text eol=lf
*.md            text eol=lf
*.txt           text eol=lf

# ⚠ vendor 许可原文**只允许原字节**
# 它们的 sha256 被同目录 PROVENANCE.json 固定，并在构建时逐文件校验；
# 任何行尾归一化（LF↔CRLF）都会改变字节 → 让校验在别的机器/别的 git 配置下凭空失败。
# 故显式 -text（等同 binary：不转换、不做行尾 diff 处理）。规则后置，覆盖上面的 * text=auto。
vendor/licenses/**/LICENSE*      -text
vendor/licenses/**/LICENCE*      -text
vendor/licenses/**/COPYING*      -text
vendor/licenses/**/NOTICE*       -text
vendor/licenses/**/AUTHORS*      -text

# 二进制文件不得做任何转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.whl   binary
*.dll   binary
*.pyd   binary
*.exe   binary
*.db    binary
*.woff  binary
*.woff2 binary

# ---- 用户数据资产（绝不入库）----
data/notes/
data/snapshots/
data/originals/
data/assets/
# Collections 用户组织元数据（类目 / 成员关系 / 显示标题 / 回收站）—— 与 notes 同为 durable 用户数据
data/metadata/
data/cache.db
data/cache.db-wal
data/cache.db-shm
# 结构升级时自动产生的旧索引备份（cache.db.v14r20260916-114002.bak[+-wal/-shm]）。
# 属于派生索引的备份，绝不入库；不忽略的话 `git add -A` 会把它们扫进提交。
data/cache.db.v*.bak*
data/wiki-usb.log*
data/temp_chrome_profile/

# ---- 发布构建产物（Release Builder 生成，非源码）----
dist/

# ---- 平台相关二进制（体积大，用 setup_runtime_windows.py 重建）----
runtime/

# ---- vendor 缓存（取件字节，绝不入库）----
# bundled embedding 模型字节（model.onnx / tokenizer.json 等）由
# scripts/fetch_embedding_resource.py 按 resources/embedding/default.json 契约
# **取件**到 vendor/cache/embedding/。这些字节（约 24MB）一律不进 Git，
# 否则 clone 膨胀且校验和失去意义；CI / 维护者构建前必须先 取件。
# 注意：vendor/licenses/ 下的**许可原文**是源码、必须入库（见下），
# 只忽略 vendor/cache/ 这一棵下载树。
vendor/cache/

# ---- 含明文密钥的本地配置 ----
config.ini

# ---- 个人记忆与交付产物 ----
.workbuddy/

# ---- 一次性临时脚本（约定前缀，由 setup_runtime_windows.py --clean 清理）----
# 它们本身是垃圾，绝不该进仓库；这条规则让 `git add -A` 也不可能误提交。
# （教训：曾把临时 CI 监视脚本 add 进提交，只能再补一笔删除。）
scripts/_tmp_*.py

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ── 凭据类文件：绝不允许进仓库 ──────────────────────────────
# 本地配置允许明文保存 API Key（Local-First），但**只在本机**。
.env
.env.*
*.env
secrets.txt
credentials.json
*.pem
*.key
id_rsa
id_ed25519
.gh_token*
*_token.txt
*_secret.txt

# 无控制台启动时写入的运行时 PID（供停止脚本使用），不入库
wiki-usb.pid

# 离线授权：签发私钥**只在本机**（*.pem / *.key 上面已全局忽略）。
# 这里再显式钉死目录意图 —— 私钥绝不入库、绝不被 build_release.py 拷进发布产物
# （构建只拷 app/ + runtime/ + 文档白名单，tools/ 从不随包）。
tools/license_generator/keys/

# RAG Eval Lab：私人题库/私人语料不入库（公开仓库只保留 core_gold）
eval/datasets/private/*
!eval/datasets/private/.gitkeep

# Reranker Spike：模型只用于开发 A/B，绝不入库/进包
eval/models/
